{
  "name": "comparecraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:build:bin": "tauri build --no-bundle",
    "app:build:linux": "tauri build --bundles deb,rpm,appimage",
    "app:build:windows": "tauri build --bundles nsis,msi",
    "app:build:macos": "tauri build --bundles app,dmg",
    "ccomp": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --bin ccomp --",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "npm run typecheck && npm run test:rust",
    "parity": "bash scripts/parity.sh",
    "docs:install": "node scripts/docs.mjs install",
    "docs:serve": "node scripts/docs.mjs serve",
    "docs:build": "node scripts/docs.mjs build",
    "package:arch": "cd packaging/arch && makepkg -si"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "marked": "^16.4.2",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14"
  }
}
