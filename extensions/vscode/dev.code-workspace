{
  "folders": [{ "path": "." }],
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run CompareCraft Extension",
        "type": "extensionHost",
        "request": "launch",
        "args": ["--extensionDevelopmentPath=${workspaceFolder:vscode}"],
        "outFiles": ["${workspaceFolder:vscode}/out/**/*.js"],
        "preLaunchTask": "Build extension"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build extension",
        "type": "shell",
        "command": "npm run build",
        "options": { "cwd": "${workspaceFolder:vscode}" },
        "problemMatcher": "$tsc",
        "group": "build"
      }
    ]
  }
}
