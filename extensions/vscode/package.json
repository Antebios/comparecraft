{
  "name": "comparecraft",
  "displayName": "CompareCraft",
  "description": "Compare files, folders, editor text, and Git revisions in VS Code or your installed CompareCraft desktop app, and resolve Git conflicts with CompareCraft.",
  "version": "0.1.0",
  "publisher": "antebios",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Antebios/comparecraft.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onWebviewPanel:comparecraft.textCompare"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "CompareCraft launches a locally installed executable and requires workspace trust."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "CompareCraft currently requires local files and folders."
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "build:webview": "npm --prefix ../.. run build:webview",
    "build:all": "npm run build:webview && npm run build",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test out/test/*.test.js",
    "test:integration": "npm run build:webview && npm run build && node scripts/test-integration.cjs",
    "vscode:prepublish": "npm run build:webview && npm run build",
    "package": "vsce package --no-dependencies",
    "test:vsix": "node scripts/test-vsix.cjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "comparecraft.compareSelected",
        "title": "Compare Selected...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareSelectedDesktop",
        "title": "Compare Selected in Desktop App",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareSelectedEmbedded",
        "title": "Compare Selected in VS Code",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.selectLeft",
        "title": "Select Left File or Folder",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareWithLeft",
        "title": "Compare with Selected Left...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.clearLeft",
        "title": "Clear Left Selections",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareFileWith",
        "title": "Compare File With...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareFolderWith",
        "title": "Compare Folder With...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareParentFolderWith",
        "title": "Compare Parent Folder With...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.openDesktop",
        "title": "Open Desktop App",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.locateDesktop",
        "title": "Locate Desktop Executable...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareWithSaved",
        "title": "Compare with Saved",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareWithClipboard",
        "title": "Compare Selection with Clipboard",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.selectLeftText",
        "title": "Select Text as Left",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareTextWithLeft",
        "title": "Compare Text with Left",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareActiveDiff",
        "title": "Open Active Diff in Desktop App",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.gitCompareHead",
        "title": "Compare with HEAD",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.gitCompareIndex",
        "title": "Compare Index with Working Tree",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.gitCompareHeadIndex",
        "title": "Compare HEAD with Index",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.gitCompareRevision",
        "title": "Compare with Revision...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.gitResolveConflictEmbedded",
        "title": "Resolve Conflict in VS Code",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.gitResolveConflict",
        "title": "Resolve Conflict in Desktop App",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.gitStageResolved",
        "title": "Stage Resolved Conflict...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.configureGitTools",
        "title": "Configure as Git Merge/Diff Tool...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.removeGitTools",
        "title": "Remove Git Tool Configuration...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.checkBackend",
        "title": "Check Embedded Backend",
        "category": "CompareCraft"
      }
    ],
    "submenus": [
      {
        "id": "comparecraft.comparisons",
        "label": "CompareCraft"
      },
      {
        "id": "comparecraft.git",
        "label": "Git"
      },
      {
        "id": "comparecraft.scm",
        "label": "CompareCraft"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "comparecraft.comparisons",
          "when": "resourceScheme == file",
          "group": "navigation@90"
        }
      ],
      "editor/context": [
        {
          "submenu": "comparecraft.comparisons",
          "when": "resourceScheme == file || resourceScheme == untitled",
          "group": "navigation@90"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "comparecraft.comparisons",
          "when": "resourceScheme == file",
          "group": "navigation@90"
        }
      ],
      "editor/title": [
        {
          "command": "comparecraft.compareActiveDiff",
          "when": "isInDiffEditor",
          "group": "1_comparecraft@1"
        }
      ],
      "scm/resourceState/context": [
        {
          "submenu": "comparecraft.scm",
          "when": "scmProvider == git",
          "group": "comparecraft@1"
        }
      ],
      "comparecraft.scm": [
        {
          "command": "comparecraft.gitResolveConflictEmbedded",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "1_conflict@1"
        },
        {
          "command": "comparecraft.gitResolveConflict",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "1_conflict@2"
        },
        {
          "command": "comparecraft.gitStageResolved",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "1_conflict@3"
        },
        {
          "command": "comparecraft.gitCompareHead",
          "when": "scmProvider == git && scmResourceGroup != merge",
          "group": "2_compare@1"
        },
        {
          "command": "comparecraft.gitCompareIndex",
          "when": "scmProvider == git && scmResourceGroup == workingTree",
          "group": "2_compare@2"
        },
        {
          "command": "comparecraft.gitCompareHeadIndex",
          "when": "scmProvider == git && scmResourceGroup == index",
          "group": "2_compare@3"
        },
        {
          "command": "comparecraft.gitCompareRevision",
          "when": "scmProvider == git && scmResourceGroup != merge && scmResourceGroup != untracked",
          "group": "2_compare@4"
        }
      ],
      "commandPalette": [
        {
          "command": "comparecraft.compareTextWithLeft",
          "when": "comparecraft.hasLeftText"
        },
        {
          "command": "comparecraft.compareActiveDiff",
          "when": "isInDiffEditor"
        }
      ],
      "comparecraft.comparisons": [
        {
          "command": "comparecraft.compareSelected",
          "when": "resourceScheme == file",
          "group": "1_compare@1"
        },
        {
          "command": "comparecraft.compareSelectedDesktop",
          "when": "resourceScheme == file",
          "group": "1_compare@2"
        },
        {
          "command": "comparecraft.compareSelectedEmbedded",
          "when": "resourceScheme == file",
          "group": "1_compare@3"
        },
        {
          "command": "comparecraft.compareWithSaved",
          "when": "editorTextFocus && activeEditorIsDirty && resourceScheme == file",
          "group": "1_compare@4"
        },
        {
          "command": "comparecraft.selectLeft",
          "when": "resourceScheme == file",
          "group": "2_left@1"
        },
        {
          "command": "comparecraft.compareWithLeft",
          "when": "comparecraft.hasLeft && resourceScheme == file",
          "group": "2_left@2"
        },
        {
          "command": "comparecraft.clearLeft",
          "when": "comparecraft.hasLeft || comparecraft.hasLeftText",
          "group": "2_left@9"
        },
        {
          "command": "comparecraft.selectLeftText",
          "when": "editorTextFocus",
          "group": "3_text@1"
        },
        {
          "command": "comparecraft.compareTextWithLeft",
          "when": "editorTextFocus && comparecraft.hasLeftText",
          "group": "3_text@2"
        },
        {
          "command": "comparecraft.compareWithClipboard",
          "when": "editorTextFocus",
          "group": "3_text@3"
        },
        {
          "command": "comparecraft.compareFileWith",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "4_picker@1"
        },
        {
          "command": "comparecraft.compareFolderWith",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "4_picker@2"
        },
        {
          "command": "comparecraft.compareParentFolderWith",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "4_picker@3"
        },
        {
          "submenu": "comparecraft.git",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "5_git@1"
        },
        {
          "command": "comparecraft.openDesktop",
          "group": "6_app@1"
        }
      ],
      "comparecraft.git": [
        {
          "command": "comparecraft.gitCompareHead",
          "group": "1_compare@1"
        },
        {
          "command": "comparecraft.gitCompareIndex",
          "group": "1_compare@2"
        },
        {
          "command": "comparecraft.gitCompareHeadIndex",
          "group": "1_compare@3"
        },
        {
          "command": "comparecraft.gitCompareRevision",
          "group": "1_compare@4"
        },
        {
          "command": "comparecraft.gitResolveConflictEmbedded",
          "group": "2_conflict@1"
        },
        {
          "command": "comparecraft.gitResolveConflict",
          "group": "2_conflict@2"
        },
        {
          "command": "comparecraft.gitStageResolved",
          "group": "2_conflict@3"
        },
        {
          "command": "comparecraft.configureGitTools",
          "group": "3_tools@1"
        },
        {
          "command": "comparecraft.removeGitTools",
          "group": "3_tools@2"
        }
      ]
    },
    "configuration": {
      "title": "CompareCraft",
      "properties": {
        "comparecraft.defaultMode": {
          "type": "string",
          "enum": [
            "embedded",
            "desktop"
          ],
          "default": "embedded",
          "description": "Default destination for comparisons. Embedded mode shows two-sided text comparisons (files, editor text, clipboard, Git revisions) in a VS Code panel; folder comparisons ask before opening the desktop app. Git conflicts open in an embedded three-way merge with CompareCraft: Resolve Conflict. Desktop mode always launches the installed app.",
          "scope": "window"
        },
        "comparecraft.desktopPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the installed desktop executable, not its directory. Empty enables standard-location discovery. AppImages require an explicit path.",
          "scope": "machine"
        },
        "comparecraft.backendPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the headless comparecraft-backend executable used by embedded mode, not its directory. Empty uses the helper installed next to the desktop app. An invalid path fails without falling back.",
          "scope": "machine"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "typescript": "~5.9.3"
  }
}
