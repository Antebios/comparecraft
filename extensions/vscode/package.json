{
  "name": "comparecraft",
  "displayName": "CompareCraft",
  "description": "Compare files, folders, editor text, and Git revisions in VS Code or your installed CompareCraft desktop app, and resolve Git conflicts with CompareCraft. Works in local, remote (SSH, WSL, Dev Containers), virtual, untrusted (read-only) and browser workspaces.",
  "version": "0.1.0",
  "publisher": "MacrossPlusInc",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Antebios/comparecraft.git",
    "directory": "extensions/vscode"
  },
  "vsce": {
    "baseContentUrl": "https://github.com/Antebios/comparecraft/blob/main/extensions/vscode",
    "baseImagesUrl": "https://raw.githubusercontent.com/Antebios/comparecraft/main/extensions/vscode"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "browser": "./out/web/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:comparecraft.textCompare"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode CompareCraft compares read-only in VS Code. Saving, Git commands and the desktop app need workspace trust.",
      "restrictedConfigurations": [
        "comparecraft.desktopPath",
        "comparecraft.backendPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Files of virtual workspaces are compared in VS Code and saved where the provider allows it; folders are compared from bounded read-only copies. Git commands and the desktop app need files on disk."
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "build:webview": "npm --prefix ../.. run build:webview",
    "build:engine": "node scripts/build-engine.cjs",
    "build:web": "node scripts/build-web.cjs",
    "build:all": "npm run build:webview && npm run build:engine && npm run build && npm run build:web",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test out/test/*.test.js",
    "test:integration": "npm run build:webview && npm run build:engine && npm run build && node scripts/test-integration.cjs",
    "test:web": "npm run build:webview && npm run build:engine && node scripts/build-web.cjs --tests && node scripts/test-web.cjs",
    "vscode:prepublish": "node scripts/prepublish.cjs",
    "package": "vsce package --no-dependencies",
    "package:targets": "node scripts/package-targets.cjs",
    "stage:helper": "node scripts/stage-helper.cjs",
    "test:vsix": "node scripts/test-vsix.cjs",
    "test:remote": "node scripts/test-remote.cjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "comparecraft.compareSelected",
        "title": "Compare Selected...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareSelectedDesktop",
        "title": "Compare Selected in Desktop App",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareSelectedEmbedded",
        "title": "Compare Selected in VS Code",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.selectLeft",
        "title": "Select Left File or Folder",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareWithLeft",
        "title": "Compare with Selected Left...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.clearLeft",
        "title": "Clear Left Selections",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareFileWith",
        "title": "Compare File With...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareFolderWith",
        "title": "Compare Folder With...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareParentFolderWith",
        "title": "Compare Parent Folder With...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.openSavedFolderSession",
        "title": "Open Saved Folder Session...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.openDesktop",
        "title": "Open Desktop App",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.locateDesktop",
        "title": "Locate Desktop Executable...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareWithSaved",
        "title": "Compare with Saved",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareWithClipboard",
        "title": "Compare Selection with Clipboard",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.selectLeftText",
        "title": "Select Text as Left",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareTextWithLeft",
        "title": "Compare Text with Left",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.compareActiveDiff",
        "title": "Open Active Diff in Desktop App",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.gitCompareHead",
        "title": "Compare with HEAD",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.gitCompareIndex",
        "title": "Compare Index with Working Tree",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.gitCompareHeadIndex",
        "title": "Compare HEAD with Index",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.gitCompareRevision",
        "title": "Compare with Revision...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.gitResolveConflictEmbedded",
        "title": "Resolve Conflict in VS Code",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.gitResolveConflict",
        "title": "Resolve Conflict in Desktop App",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.gitStageResolved",
        "title": "Stage Resolved Conflict...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.configureGitTools",
        "title": "Configure as Git Merge/Diff Tool...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.removeGitTools",
        "title": "Remove Git Tool Configuration...",
        "category": "CompareCraft"
      },
      {
        "command": "comparecraft.checkBackend",
        "title": "Check Embedded Backend",
        "category": "CompareCraft"
      }
    ],
    "submenus": [
      {
        "id": "comparecraft.comparisons",
        "label": "CompareCraft"
      },
      {
        "id": "comparecraft.git",
        "label": "Git"
      },
      {
        "id": "comparecraft.scm",
        "label": "CompareCraft"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "comparecraft.comparisons",
          "when": "resourceScheme in comparecraft.schemes",
          "group": "navigation@90"
        }
      ],
      "editor/context": [
        {
          "submenu": "comparecraft.comparisons",
          "when": "resourceScheme in comparecraft.schemes || resourceScheme == untitled",
          "group": "navigation@90"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "comparecraft.comparisons",
          "when": "resourceScheme in comparecraft.schemes",
          "group": "navigation@90"
        }
      ],
      "editor/title": [
        {
          "command": "comparecraft.compareActiveDiff",
          "when": "isInDiffEditor && comparecraft.desktop",
          "group": "1_comparecraft@1"
        }
      ],
      "scm/resourceState/context": [
        {
          "submenu": "comparecraft.scm",
          "when": "scmProvider == git && comparecraft.git",
          "group": "comparecraft@1"
        }
      ],
      "comparecraft.scm": [
        {
          "command": "comparecraft.gitResolveConflictEmbedded",
          "when": "scmProvider == git && scmResourceGroup == merge && comparecraft.git",
          "group": "1_conflict@1"
        },
        {
          "command": "comparecraft.gitResolveConflict",
          "when": "scmProvider == git && scmResourceGroup == merge && comparecraft.git && comparecraft.desktop",
          "group": "1_conflict@2"
        },
        {
          "command": "comparecraft.gitStageResolved",
          "when": "scmProvider == git && scmResourceGroup == merge && comparecraft.git",
          "group": "1_conflict@3"
        },
        {
          "command": "comparecraft.gitCompareHead",
          "when": "scmProvider == git && scmResourceGroup != merge && comparecraft.git",
          "group": "2_compare@1"
        },
        {
          "command": "comparecraft.gitCompareIndex",
          "when": "scmProvider == git && scmResourceGroup == workingTree && comparecraft.git",
          "group": "2_compare@2"
        },
        {
          "command": "comparecraft.gitCompareHeadIndex",
          "when": "scmProvider == git && scmResourceGroup == index && comparecraft.git",
          "group": "2_compare@3"
        },
        {
          "command": "comparecraft.gitCompareRevision",
          "when": "scmProvider == git && scmResourceGroup != merge && scmResourceGroup != untracked && comparecraft.git",
          "group": "2_compare@4"
        }
      ],
      "commandPalette": [
        {
          "command": "comparecraft.compareTextWithLeft",
          "when": "comparecraft.hasLeftText"
        },
        {
          "command": "comparecraft.compareActiveDiff",
          "when": "isInDiffEditor && comparecraft.desktop"
        },
        {
          "command": "comparecraft.compareSelectedDesktop",
          "when": "comparecraft.desktop"
        },
        {
          "command": "comparecraft.openDesktop",
          "when": "comparecraft.desktop"
        },
        {
          "command": "comparecraft.locateDesktop",
          "when": "comparecraft.desktop"
        },
        {
          "command": "comparecraft.openSavedFolderSession",
          "when": "comparecraft.folders"
        },
        {
          "command": "comparecraft.gitResolveConflict",
          "when": "comparecraft.git && comparecraft.desktop"
        },
        {
          "command": "comparecraft.configureGitTools",
          "when": "comparecraft.git && comparecraft.desktop"
        },
        {
          "command": "comparecraft.gitCompareHead",
          "when": "comparecraft.git"
        },
        {
          "command": "comparecraft.gitCompareIndex",
          "when": "comparecraft.git"
        },
        {
          "command": "comparecraft.gitCompareHeadIndex",
          "when": "comparecraft.git"
        },
        {
          "command": "comparecraft.gitCompareRevision",
          "when": "comparecraft.git"
        },
        {
          "command": "comparecraft.gitResolveConflictEmbedded",
          "when": "comparecraft.git"
        },
        {
          "command": "comparecraft.gitStageResolved",
          "when": "comparecraft.git"
        },
        {
          "command": "comparecraft.removeGitTools",
          "when": "comparecraft.git"
        }
      ],
      "comparecraft.comparisons": [
        {
          "command": "comparecraft.compareSelected",
          "when": "resourceScheme in comparecraft.schemes",
          "group": "1_compare@1"
        },
        {
          "command": "comparecraft.compareSelectedDesktop",
          "when": "resourceScheme in comparecraft.schemes && comparecraft.desktop",
          "group": "1_compare@2"
        },
        {
          "command": "comparecraft.compareSelectedEmbedded",
          "when": "resourceScheme in comparecraft.schemes",
          "group": "1_compare@3"
        },
        {
          "command": "comparecraft.compareWithSaved",
          "when": "editorTextFocus && activeEditorIsDirty && resourceScheme in comparecraft.schemes",
          "group": "1_compare@4"
        },
        {
          "command": "comparecraft.selectLeft",
          "when": "resourceScheme in comparecraft.schemes",
          "group": "2_left@1"
        },
        {
          "command": "comparecraft.compareWithLeft",
          "when": "comparecraft.hasLeft && resourceScheme in comparecraft.schemes",
          "group": "2_left@2"
        },
        {
          "command": "comparecraft.clearLeft",
          "when": "comparecraft.hasLeft || comparecraft.hasLeftText",
          "group": "2_left@9"
        },
        {
          "command": "comparecraft.selectLeftText",
          "when": "editorTextFocus",
          "group": "3_text@1"
        },
        {
          "command": "comparecraft.compareTextWithLeft",
          "when": "editorTextFocus && comparecraft.hasLeftText",
          "group": "3_text@2"
        },
        {
          "command": "comparecraft.compareWithClipboard",
          "when": "editorTextFocus",
          "group": "3_text@3"
        },
        {
          "command": "comparecraft.compareFileWith",
          "when": "resourceScheme in comparecraft.schemes && !explorerResourceIsFolder",
          "group": "4_picker@1"
        },
        {
          "command": "comparecraft.compareFolderWith",
          "when": "resourceScheme in comparecraft.schemes && explorerResourceIsFolder && comparecraft.folders",
          "group": "4_picker@2"
        },
        {
          "command": "comparecraft.compareParentFolderWith",
          "when": "resourceScheme in comparecraft.schemes && !explorerResourceIsFolder && comparecraft.folders",
          "group": "4_picker@3"
        },
        {
          "submenu": "comparecraft.git",
          "when": "comparecraft.git && resourceScheme in comparecraft.localSchemes && !explorerResourceIsFolder",
          "group": "5_git@1"
        },
        {
          "command": "comparecraft.openDesktop",
          "group": "6_app@1",
          "when": "comparecraft.desktop"
        }
      ],
      "comparecraft.git": [
        {
          "command": "comparecraft.gitCompareHead",
          "group": "1_compare@1"
        },
        {
          "command": "comparecraft.gitCompareIndex",
          "group": "1_compare@2"
        },
        {
          "command": "comparecraft.gitCompareHeadIndex",
          "group": "1_compare@3"
        },
        {
          "command": "comparecraft.gitCompareRevision",
          "group": "1_compare@4"
        },
        {
          "command": "comparecraft.gitResolveConflictEmbedded",
          "group": "2_conflict@1"
        },
        {
          "command": "comparecraft.gitResolveConflict",
          "group": "2_conflict@2",
          "when": "comparecraft.desktop"
        },
        {
          "command": "comparecraft.gitStageResolved",
          "group": "2_conflict@3"
        },
        {
          "command": "comparecraft.configureGitTools",
          "group": "3_tools@1",
          "when": "comparecraft.desktop"
        },
        {
          "command": "comparecraft.removeGitTools",
          "group": "3_tools@2"
        }
      ]
    },
    "configuration": {
      "title": "CompareCraft",
      "properties": {
        "comparecraft.defaultMode": {
          "type": "string",
          "enum": [
            "embedded",
            "desktop"
          ],
          "default": "embedded",
          "description": "Default destination for comparisons. Embedded mode shows comparisons (files, folders, editor text, clipboard, Git revisions) in VS Code panels. Git conflicts open in an embedded three-way merge with CompareCraft: Resolve Conflict. Desktop mode launches the installed app where it can open the files (not in remote windows, virtual workspaces, browser VS Code or Restricted Mode, which offer the embedded comparison instead).",
          "scope": "window"
        },
        "comparecraft.desktopPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the installed desktop executable, not its directory. Empty enables standard-location discovery. AppImages require an explicit path.",
          "scope": "machine"
        },
        "comparecraft.backendPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the headless comparecraft-backend executable used by embedded mode, not its directory. Empty uses the helper bundled with this extension, then the one installed next to the desktop app, and otherwise the built-in WebAssembly engine. An invalid path fails without falling back. In a remote window this is a setting of the remote host.",
          "scope": "machine"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  }
}
